<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PALET WARNA DASAR: TITANIUM, CHARCOAL, GRAPHITE (Grayscale Netral) -->
    <!-- Latar Belakang Utama -->
    <Color x:Key="AppBackgroundDarkColor">#0E0E10</Color>
    <SolidColorBrush x:Key="AppBackgroundDarkBrush" Color="{StaticResource AppBackgroundDarkColor}" />

    <!-- Latar Belakang Panel & Sidebar -->
    <Color x:Key="SurfaceDarkColor">#141417</Color>
    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource SurfaceDarkColor}" />

    <!-- Latar Belakang Kartu / Konten Sedang -->
    <Color x:Key="SurfaceMediumColor">#1B1B1F</Color>
    <SolidColorBrush x:Key="SurfaceMediumBrush" Color="{StaticResource SurfaceMediumColor}" />

    <!-- Latar Belakang Elemen Interaktif / Hover -->
    <Color x:Key="SurfaceLightColor">#24242B</Color>
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLightColor}" />

    <!-- Warna Border / Pembatas Halus -->
    <Color x:Key="BorderSubtleColor">#282830</Color>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />

    <Color x:Key="BorderHighlightColor">#383842</Color>
    <SolidColorBrush x:Key="BorderHighlightBrush" Color="{StaticResource BorderHighlightColor}" />

    <!-- Tipografi Grayscale Netral -->
    <!-- Teks Utama (Off-white bersih, kontras tinggi) -->
    <Color x:Key="TextPrimaryColor">#F3F3F5</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />

    <!-- Teks Sekunder (Abu-abu sedang) -->
    <Color x:Key="TextSecondaryColor">#A1A1AA</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <!-- Teks Muted / Disabled -->
    <Color x:Key="TextMutedColor">#5B5B66</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <!-- WARNA AKSEN YANG DAPAT DIKONFIGURASI (Default: Titanium Amber #E5A93C) -->
    <!-- Dideklarasikan sebagai DynamicResource agar dapat berganti warna saat runtime -->
    <Color x:Key="AccentColor">#E5A93C</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

    <Color x:Key="AccentColorHover">#C98F28</Color>
    <SolidColorBrush x:Key="AccentBrushHover" Color="{StaticResource AccentColorHover}" />

    <Color x:Key="AccentColorSubtle">#26E5A93C</Color>
    <SolidColorBrush x:Key="AccentBrushSubtle" Color="{StaticResource AccentColorSubtle}" />

</ResourceDictionary>
