<Application x:Class="Axon.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Axon.ViewModels"
             xmlns:views="clr-namespace:Axon.Views"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Sumber Daya Warna (Titanium/Charcoal/Graphite + Aksen Dinamis) -->
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <!-- Sumber Daya Ikon Vektor Native XAML -->
                <ResourceDictionary Source="Resources/Icons.xaml" />
                <!-- Sumber Daya Style Tipografi, Tombol, Slider, dan Tab -->
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================================================== -->
            <!-- MVVM VIEW MODEL DATA TEMPLATES                                 -->
            <!-- WPF secara otomatis me-render View yang sesuai ketika          -->
            <!-- ContentControl mengikat (bind) properti ViewModel bersangkutan. -->
            <!-- ============================================================== -->
            <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
                <views:LibraryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
