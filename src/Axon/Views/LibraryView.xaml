<UserControl x:Class="Axon.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Axon.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}">

    <Grid Background="{StaticResource AppBackgroundDarkBrush}">
        <Grid.RowDefinitions>
            <!-- Header Bar: Judul Halaman & Kotak Pencarian -->
            <RowDefinition Height="Auto" />
            <!-- Konten Utama: Daftar Lagu atau Empty State -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================== -->
        <!-- HEADER PERPUSTAKAAN MUSIK -->
        <!-- ============================================== -->
        <Border Grid.Row="0"
                Padding="32,24,32,16"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Judul Seksi -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Music Library"
                               Style="{StaticResource TextHeaderLarge}" />
                    <TextBlock Text="Your local audio tracks and imported collections"
                               Style="{StaticResource TextBodySecondary}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Filter / Search Box Minimalis -->
                <Border Grid.Column="1"
                        Width="260"
                        Height="36"
                        CornerRadius="6"
                        Background="{StaticResource SurfaceMediumBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon Kaca Pembesar -->
                        <Path Grid.Column="0"
                              Data="{StaticResource IconSearch}"
                              Fill="{StaticResource TextMutedBrush}"
                              Width="13"
                              Height="13"
                              Stretch="Uniform"
                              VerticalAlignment="Center" />

                        <!-- Placeholder / Input Pencarian -->
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 BorderThickness="0"
                                 FontSize="12"
                                 Margin="8,0,0,0"
                                 VerticalAlignment="Center" />

                        <!-- Watermark ketika SearchQuery kosong -->
                        <TextBlock Grid.Column="1"
                                   Text="Search tracks, artists..."
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- EMPTY STATE (FASE 1: PERPUSTAKAAN MASIH KOSONG) -->
        <!-- ============================================== -->
        <Border Grid.Row="1"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center"
                        MaxWidth="480">

                <!-- Icon Container Elegan Bulat -->
                <Border Width="72"
                        Height="72"
                        CornerRadius="36"
                        Background="{StaticResource SurfaceMediumBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                    <Path Data="{StaticResource IconLibrary}"
                          Fill="{DynamicResource AccentBrush}"
                          Width="28"
                          Height="28"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>

                <!-- Judul Empty State -->
                <TextBlock Text="No Music in Library"
                           Style="{StaticResource TextHeaderLarge}"
                           FontSize="18"
                           HorizontalAlignment="Center" />

                <!-- Deskripsi Informatif & Jujur Mengenai Fase 2 -->
                <TextBlock Text="AXON is currently in Phase 1 (Application Foundation). Local music folder scanning, SQLite persistence, and ID3 tag extraction will be introduced in Phase 2."
                           Style="{StaticResource TextBodySecondary}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,10,0,24"
                           LineHeight="19" />

                <!-- Tombol Informatif / Placeholder -->
                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding ImportFolderPlaceholderCommand}"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconFolder}"
                              Fill="{StaticResource TextPrimaryBrush}"
                              Width="14"
                              Height="14"
                              Stretch="Uniform"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Import Music Folder (Available in Phase 2)"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Petunjuk Format yang Didukung Nanti -->
                <TextBlock Text="Supported formats in upcoming phases: MP3, FLAC, WAV, M4A"
                           Style="{StaticResource TextCaption}"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
