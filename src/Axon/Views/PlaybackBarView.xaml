<UserControl x:Class="Axon.Views.PlaybackBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Axon.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlaybackBarViewModel}"
             Height="80">

    <!-- BOTTOM PLAYBACK BAR: Charcoal/Titanium Dark Container -->
    <Border Background="{StaticResource SurfaceDarkBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Bagian Kiri: Info Track & Artwork -->
                <ColumnDefinition Width="280" />
                <!-- Bagian Tengah: Transport Controls & Seek Timeline -->
                <ColumnDefinition Width="*" />
                <!-- Bagian Kanan: Kontrol Volume & Mini-Player -->
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- 1. BAGIAN KIRI: ARTWORK & INFORMASI TRACK SAAT INI -->
            <!-- ============================================== -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <!-- Artwork Placeholder Kotak Minimalis -->
                <Border Width="48"
                        Height="48"
                        CornerRadius="6"
                        Background="{StaticResource SurfaceMediumBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1">
                    <Path Data="{StaticResource IconVinyl}"
                          Fill="{StaticResource TextMutedBrush}"
                          Width="20"
                          Height="20"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>

                <!-- Teks Judul & Artis -->
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="{Binding DisplayTitle}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               ToolTip="{Binding DisplayTitle}" />
                    <TextBlock Text="{Binding DisplayArtist}"
                               FontSize="11"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               ToolTip="{Binding DisplayArtist}" />
                </StackPanel>
            </StackPanel>

            <!-- ============================================== -->
            <!-- 2. BAGIAN TENGAH: TRANSPORT CONTROLS & TIMELINE -->
            <!-- ============================================== -->
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="440">

                <!-- Tombol Navigasi Putar (Previous, Play/Pause, Next) -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- Previous Button -->
                    <Button Style="{StaticResource GhostIconButton}"
                            Command="{Binding PreviousCommand}"
                            ToolTip="Previous Track (Fase 3)"
                            Margin="0,0,12,0"
                            Width="32"
                            Height="32">
                        <Path Data="{StaticResource IconPrevious}"
                              Fill="{StaticResource TextPrimaryBrush}"
                              Width="14"
                              Height="14"
                              Stretch="Uniform" />
                    </Button>

                    <!-- Play / Pause Button -->
                    <Button Style="{StaticResource TransportPlayButton}"
                            Command="{Binding PlayPauseCommand}"
                            ToolTip="Play / Pause (Fase 3)"
                            Margin="0,0,12,0">
                        <Path Data="{StaticResource IconPlay}"
                              Fill="#0E0E10"
                              Width="16"
                              Height="16"
                              Margin="2,0,0,0"
                              Stretch="Uniform" />
                    </Button>

                    <!-- Next Button -->
                    <Button Style="{StaticResource GhostIconButton}"
                            Command="{Binding NextCommand}"
                            ToolTip="Next Track (Fase 3)"
                            Width="32"
                            Height="32">
                        <Path Data="{StaticResource IconNext}"
                              Fill="{StaticResource TextPrimaryBrush}"
                              Width="14"
                              Height="14"
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <!-- Timeline / Progress Bar -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>

                    <!-- Waktu Berjalan (Elapsed) -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding FormattedPosition}"
                               Style="{StaticResource TextCaption}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center" />

                    <!-- Slider Timeline -->
                    <Slider Grid.Column="1"
                            Style="{StaticResource ModernSlider}"
                            Margin="8,0"
                            IsEnabled="{Binding CanPlay}"
                            Minimum="0"
                            Maximum="100"
                            Value="0" />

                    <!-- Durasi Total -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding FormattedDuration}"
                               Style="{StaticResource TextCaption}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- ============================================== -->
            <!-- 3. BAGIAN KANAN: VOLUME & MINI-PLAYER SHORTCUT -->
            <!-- ============================================== -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <!-- Tombol Mini-Player (Placeholder Fase 5) -->
                <Button Style="{StaticResource GhostIconButton}"
                        IsEnabled="False"
                        ToolTip="Floating Mini-Player (Akan aktif di Fase 5)"
                        Margin="0,0,14,0"
                        Width="32"
                        Height="32">
                    <Path Data="{StaticResource IconMiniPlayer}"
                          Fill="{StaticResource TextSecondaryBrush}"
                          Width="15"
                          Height="15"
                          Stretch="Uniform" />
                </Button>

                <!-- Tombol Mute / Volume Icon -->
                <Button Style="{StaticResource GhostIconButton}"
                        Command="{Binding ToggleMuteCommand}"
                        ToolTip="Mute / Unmute"
                        Width="32"
                        Height="32">
                    <Path Data="{StaticResource IconVolume}"
                          Fill="{StaticResource TextSecondaryBrush}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform" />
                </Button>

                <!-- Slider Pengatur Volume -->
                <Slider Style="{StaticResource ModernSlider}"
                        Width="85"
                        Margin="8,0,10,0"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding Volume, Mode=TwoWay}"
                        ToolTip="{Binding Volume, StringFormat={}{0:0}%}" />

                <!-- Label Persentase Volume -->
                <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}"
                           Style="{StaticResource TextCaption}"
                           Width="32"
                           TextAlignment="Right"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
