<UserControl x:Class="Axon.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Axon.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource AppBackgroundDarkBrush}">
        <StackPanel Margin="32,24,32,32" MaxWidth="720" HorizontalAlignment="Left">

            <!-- HEADER PENGATURAN -->
            <TextBlock Text="Settings" Style="{StaticResource TextHeaderLarge}" />
            <TextBlock Text="Customize AXON appearance and playback preferences"
                       Style="{StaticResource TextBodySecondary}"
                       Margin="0,4,0,24" />

            <!-- SEKSI 1: WARNA AKSEN (BERFUNGSI DINAMIS) -->
            <Border Background="{StaticResource SurfaceDarkBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Accent Color" Style="{StaticResource TextSectionTitle}" />
                    <TextBlock Text="Choose an accent color for active indicators, sliders, and highlights."
                               Style="{StaticResource TextBodySecondary}"
                               Margin="0,4,0,16" />

                    <!-- Pilihan Swatch Warna Aksen -->
                    <ItemsControl ItemsSource="{Binding AccentOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AccentOption}">
                                <RadioButton GroupName="AccentColorGroup"
                                             IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                             Cursor="Hand"
                                             Margin="0,0,12,8">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="swatchBorder"
                                                                Background="{StaticResource SurfaceMediumBrush}"
                                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="10,8">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Width="16"
                                                                        Height="16"
                                                                        CornerRadius="8"
                                                                        Background="{Binding Brush}"
                                                                        Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="12"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="swatchBorder" Property="BorderBrush" Value="{StaticResource BorderHighlightBrush}" />
                                                                <Setter TargetName="swatchBorder" Property="Background" Value="{StaticResource SurfaceLightBrush}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.SelectedAccent}"
                                                                         Value="{Binding}">
                                                                <Setter TargetName="swatchBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                <Setter TargetName="swatchBorder" Property="Background" Value="{DynamicResource AccentBrushSubtle}" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </RadioButton.Style>
                                    <RadioButton.Command>
                                        <Binding Path="DataContext.SelectedAccent"
                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </RadioButton.Command>
                                    <!-- Menghubungkan klik swatch ke pergantian SelectedAccent -->
                                    <RadioButton.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.ApplyAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}" />
                                    </RadioButton.InputBindings>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- SEKSI 2: PREVIEW FITUR MENDATANG (MINI-PLAYER & THEME) -->
            <Border Background="{StaticResource SurfaceDarkBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Floating Mini-Player (Phase 5 Roadmap)"
                               Style="{StaticResource TextSectionTitle}" />
                    <TextBlock Text="Planned settings: Always-on-top, hover auto-collapse delay, corner radius, opacity, and custom screen docking."
                               Style="{StaticResource TextBodySecondary}"
                               Margin="0,4,0,12" />
                    <Border Background="{StaticResource SurfaceMediumBrush}"
                            CornerRadius="6"
                            Padding="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <TextBlock Text="• Separate lightweight overlay window&#x0a;• Expand on hover, collapse when idle&#x0a;• Real-time synchronization with main window playback state"
                                   Style="{StaticResource TextCaption}"
                                   LineHeight="18"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- SEKSI 3: INFORMASI APLIKASI & HARDWARE TARGET -->
            <Border Background="{StaticResource SurfaceDarkBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="System &amp; About" Style="{StaticResource TextSectionTitle}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Application" Style="{StaticResource TextCaption}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="AXON Music Player" Style="{StaticResource TextBodySecondary}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Version" Style="{StaticResource TextCaption}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AppVersion}" Style="{StaticResource TextBodySecondary}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Runtime Framework" Style="{StaticResource TextCaption}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TargetPlatform}" Style="{StaticResource TextBodySecondary}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Target Hardware" Style="{StaticResource TextCaption}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Intel Core i5-4200U / 8GB RAM / Windows 10 (HDD Optimized)" Style="{StaticResource TextBodySecondary}" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
